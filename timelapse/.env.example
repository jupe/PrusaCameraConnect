# Copy to .env and fill in. .env is gitignored - never commit it.

# Printer IP or hostname (PrusaLink)
PRUSALINK_HOST=192.0.2.10
PRUSALINK_USER=maker
# Printer: Settings > Network > PrusaLink
PRUSALINK_PASSWORD=changeme

# Camera: set ONE of these (same source as prusacameraconnect's config)
CAMERA_RTSP=rtsp://user:pass@192.0.2.20:554/stream1
# CAMERA_SNAPSHOT_URL=http://192.0.2.20/snapshot.jpg

# Seconds between frames; 2-3 is better for catching collisions
INTERVAL=5
# Output video fps
FPS=25
# Higher = smaller file
CRF=28
# Keep jpg frames after encoding
KEEP_FRAMES=false
# Delete videos/images older than N days and drop them from history (0 = keep forever)
RETENTION_DAYS=60
# Max entries kept in history.json
HISTORY_MAX=50
# Port for the read-only HTTP server (history.json, videos, thumbnails)
HTTP_PORT=8099

TZ=Europe/Helsinki
